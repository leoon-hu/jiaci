# Copy these settings into .env and use a deliverable email for each account.
AUTH_MODE=api_key
AUTH_API_KEYS='[{"email":"alice@example.com","key":"REPLACE_WITH_ALICE_KEY"},{"email":"bob@example.com","key":"REPLACE_WITH_BOB_KEY"}]'
# Generate each key independently with openssl rand -hex 32.
# Keep DATABASE_URL, SESSION_SECRET and any mail settings in the main .env.
