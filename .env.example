# 本地开发环境变量（勿提交生产密钥）
DATABASE_URL="postgresql://aiword:aiword@127.0.0.1:5432/aiword?schema=public"
# 会话签名密钥（生产环境务必更换）
SESSION_SECRET="replace-with-a-long-random-string"
# 有 Key 时真实发送验证码邮件；为空则开发模式在页面内显示验证码
RESEND_API_KEY=""
NODE_ENV=development

# 词条 AI 字段填充脚本用的厂商密钥（只在运营脚本里用，应用运行时不调用）
DEEPSEEK_API_KEY=
# OpenAI 的模型经 openrouter.ai 调用（写 word_ai_openai 表，模型名带 openai/ 前缀，默认 openai/gpt-5.4-mini）
OPENROUTER_API_KEY=

# 发音音频文件目录（默认项目下 storage/audio；生产环境指定独立数据盘路径）
AUDIO_DIR=
# 线上：nginx 里 internal location 的前缀，设了之后音频文件由 nginx 直接发（X-Accel-Redirect），
# 应用只做鉴权。本机开发不要设，留空就自己读文件返回。
# AUDIO_ACCEL="/_audio"
# 备选合成引擎 Kokoro-FastAPI 的地址（system_config.tts.provider = kokoro 时必填），如 http://127.0.0.1:8880
KOKORO_BASE_URL=

# 清理任务的调用口令（服务器 cron 调 POST /api/internal/purge 用）；留空则该接口一律 404
PURGE_TOKEN=

# 站点对外主机名（如 example.com）：中间件拼登录跳转地址时只认它，防止请求头里的假 Host 把用户带走；留空则用请求头
SITE_HOST=

# 部署目标服务器（部署脚本用），如 root@1.2.3.4；本机开发留空
DEPLOY_HOST=
