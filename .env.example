# 本地开发环境变量（勿提交生产密钥）
DATABASE_URL="postgresql://aiword:aiword@127.0.0.1:5432/aiword?schema=public"
# 会话签名密钥（生产环境务必更换）
SESSION_SECRET="replace-with-a-long-random-string"
# 有 Key 时真实发送验证码邮件；为空则开发模式在页面内显示验证码
RESEND_API_KEY=""
NODE_ENV=development

# 词条 AI 字段填充脚本用的厂商密钥。DEEPSEEK_API_KEY 在线上也要配：用户在详情页对没有资料的词点「生成 AI 资料」时
# 服务端会调一次 DeepSeek（每人每天有次数上限，见 system_config 的 ai.generate_*）；不配就不显示那个按钮。浏览 / 添加 / 导入从不调用
DEEPSEEK_API_KEY=
# OpenAI 的模型经 openrouter.ai 调用（写 word_ai_openai 表，模型名带 openai/ 前缀，默认 openai/gpt-5.4-mini）
OPENROUTER_API_KEY=

# 发音音频文件目录（默认项目下 storage/audio；生产环境指定独立数据盘路径）
AUDIO_DIR=
# 线上：nginx 里 internal location 的前缀，设了之后音频文件由 nginx 直接发（X-Accel-Redirect），
# 应用只做鉴权。本机开发不要设，留空就自己读文件返回。
# AUDIO_ACCEL="/_audio"
# 备选合成引擎 Kokoro-FastAPI 的地址（system_config.tts.provider = kokoro 时必填），如 http://127.0.0.1:8880
KOKORO_BASE_URL=

# 清理任务的调用口令（服务器 cron 调 POST /api/internal/purge 用）；留空则该接口一律 404
PURGE_TOKEN=

# 站点对外主机名（如 example.com）：中间件拼登录跳转地址时只认它，防止请求头里的假 Host 把用户带走；留空则用请求头
SITE_HOST=
# 站点对外地址（如 https://example.com）：分享卡片（og:image）、robots、sitemap 里的绝对地址按它拼；没配就按 SITE_HOST 拼 https。
# 登录页、robots.txt、sitemap.xml 是构建时预渲染的，在别的机器上构建再部署时，构建机的 .env 也要写这一项
SITE_URL=

# 部署目标服务器（部署脚本用），如 root@1.2.3.4；本机开发留空
DEPLOY_HOST=

# 访问统计（可选，Umami，开源自建）：两项都填了，构建时会往每页加一行上报脚本（NEXT_PUBLIC_ 在构建机内联，运行机不用配）；
# 留空就什么都不加。只记页面、来源、设备与地区，账号与学习记录不上报
NEXT_PUBLIC_UMAMI_SCRIPT=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# —— 双模式认证（详见 AUTH-MODE.md）——
# 认证模式：email（原版邮箱验证码登录）/ api_key（私有 API Key 登录），两者互斥；未设置默认 email
AUTH_MODE=email
# api_key 模式填写 JSON 列表。每把密钥用 openssl rand -hex 32 单独生成，仅在服务端使用。
# AUTH_API_KEYS='[{"email":"alice@example.com","key":"REPLACE_WITH_ALICE_KEY"},{"email":"bob@example.com","key":"REPLACE_WITH_BOB_KEY"}]'
AUTH_API_KEYS=
# AUTH_API_KEYS 留空时可继续使用旧的 AUTH_API_KEY 和 AUTH_PRIVATE_USER 配置。
