# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 本地环境变量
.env
!.env.example

# 外部词典等本地数据（ECDICT csv，几十 MB，见 scripts/dict.ts）
/data/

# 发音音频文件（AUDIO_DIR 默认位置；可由脚本重新生成）
/storage/

# 项目级忽略
.idea/
*.log

# 文档与部署脚本只留在本机
/docs/
/deploy/
