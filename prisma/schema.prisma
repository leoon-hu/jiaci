  etymology    Json?
  /// 填充时间
  generatedAt  DateTime @default(now()) @map("generated_at")
  /// 来源：模型@提示词版本（如 gpt-5@1），运营手改为 manual
  source       String
  word         Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)

  /// 列表搜索按核心义包含匹配（ILIKE '%…%'）。两个索引各管一半：
  /// (core, word_id) 让任何关键词都能只扫这个几百 KB 的索引（Index Only Scan），不必读 49 MB 的表；
  /// trigram GIN 让 3 个字符以上的关键词直接定位（中文两字词提不出 trigram，只能靠上面那个）
  @@index([core, wordId])
  @@index([core(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("word_ai_deepseek")
}

/// 用户对词条的问题反馈：只记录，运营方用 SQL 查看处理
model WordFeedback {
  /// 反馈 ID
  id        String   @id @default(cuid())
  /// 提交人
  userId    String   @map("user_id")
  /// 反馈的单词
  wordId    String   @map("word_id")
  /// 反馈内容，最多 500 字
  content   String   @db.VarChar(500)
  /// 提交时间
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  word      Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([wordId])
  @@index([userId, createdAt])
  @@map("word_feedback")
}

/// 用户单词备注表（需求 3.2.5）：每人每词一条，仅本人可见
model UserWordNote {
  /// 用户 ID
  userId    String   @map("user_id")
  /// 单词 ID
  wordId    String   @map("word_id")
  /// 备注内容，最多 200 字
  note      String   @db.VarChar(200)
  /// 最近修改时间
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  word      Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@id([userId, wordId])
  /// 删词时的级联要按 word_id 找行
  @@index([wordId])
  @@map("user_word_note")
}

/// 用户单词学习进度表（需求 3.2.4，FSRS 调度）：无记录 = 未学过
model UserWordProgress {
  /// 用户 ID
  userId     String         @map("user_id")
  /// 单词 ID
  wordId     String         @map("word_id")
  /// 当前安排的复习间隔（天，FSRS 的 scheduled_days）；0 表示新词
  interval   Int            @default(0)
  /// FSRS 记忆稳定性（天）；新词为空
  stability  Float?
  /// FSRS 难度 1–10；新词为空
  difficulty Float?
  /// 最近一次打分的日期，用于按实际间隔计算
  lastReview DateTime?      @map("last_review") @db.Date
  /// 下次复习日期；已掌握 / 已移出为空
  dueDate    DateTime?      @map("due_date") @db.Date
  /// 学习次数（累计打分次数）
  reps       Int            @default(0)
  /// 遗忘次数（复习时打「模糊」的次数）
  lapses     Int            @default(0)
  /// 状态：new 未开始 / learning 学习中 / mastered 已掌握 / removed 已移出
  status     ProgressStatus @default(new)
  /// 进度作用域：空串 = 全局进度（默认，所有词库共用）；否则 = 开了「独立进度」的词库 id，该词库里的词单独一套记录。
  /// 用空串而不是可空的词库 id：主键列不能为空；不建外键，删词库时显式清理这个作用域的行
  scope      String         @default("")
  /// 最近更新时间
  updatedAt  DateTime       @updatedAt @map("updated_at")
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  word       Word           @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@id([userId, wordId, scope])
  @@index([userId, dueDate])
  @@index([userId, status])
  /// 删词时的级联要按 word_id 找行，没有前导索引会顺序扫全表
  @@index([wordId])
  @@map("user_word_progress")
}

/// 学习记录表：每次打分或状态操作一条，用于「今日已完成」统计与详情页学习记录时间线
model StudyLog {
  /// 记录 ID
  id           String      @id @default(cuid())
  /// 用户 ID
  userId       String      @map("user_id")
  /// 单词 ID
  wordId       String      @map("word_id")
  /// 结果：know 认识 / fuzzy 模糊 / master 已掌握 / reset 重新记 / remove 移出
  result       StudyResult
  /// 打分后的下次间隔（天）：0 = 今日再出现，-1 = 不再出现
  nextInterval Int         @default(0) @map("next_interval")
  /// 来源：study 学习卡片 / list 单词列表的批量操作
  source       StudySource @default(study)
  /// 客户端提交标识，用于离线重试时去重（同一用户内唯一）
  clientTs     String?     @map("client_ts")
  /// 打分时间（服务器 UTC 时刻）
  studiedAt    DateTime    @default(now()) @map("studied_at")
  /// 学习日期：打分时采用的**客户端本地日期**，今日队列、今日已完成、学习记录时间线都按它算；
  /// 不能用 studied_at 的 UTC 日期代替——本地日期与 UTC 日期不一致的用户会算错一天
  studyDate    DateTime    @default(dbgenerated("CURRENT_DATE")) @map("study_date") @db.Date
  /// 进度作用域，与 user_word_progress.scope 同义：这条记录属于全局进度（空串）还是某本词库的独立进度
  scope        String      @default("")
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  word         Word        @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, clientTs])
  @@index([userId, studiedAt])
  @@index([userId, studyDate])
  @@index([userId, wordId, studiedAt])
  /// 删词时的级联要按 word_id 找行
  @@index([wordId])
  @@map("study_log")
}

/// 用户当前学习词库表：每人同一时间只有一个当前词库
model UserCurrentWordbook {
  /// 用户 ID
  userId     String   @id @map("user_id")
  /// 当前学习的词库 ID
  wordbookId String   @map("wordbook_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wordbook   Wordbook @relation(fields: [wordbookId], references: [id], onDelete: Cascade)

  /// 删词库时的级联要按 wordbook_id 找行
  @@index([wordbookId])
  @@map("user_current_wordbook")
}

/// 用户对某本词库的设置表：目前只有「独立进度」开关。内置词库大家共用，所以按用户分开存；没有行 = 默认（全局进度）
model UserWordbookSetting {
  /// 用户 ID
  userId      String   @map("user_id")
  /// 词库 ID
  wordbookId  String   @map("wordbook_id")
  /// 独立进度：开着时这本词库里的词读写 scope = 词库 id 的那套进度，关掉回到全局进度；两套都保留，来回切换互不影响
  ownProgress Boolean  @default(false) @map("own_progress")
  /// 最近修改时间
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wordbook    Wordbook @relation(fields: [wordbookId], references: [id], onDelete: Cascade)

  @@id([userId, wordbookId])
  /// 删词库时的级联要按 wordbook_id 找行
  @@index([wordbookId])
  @@map("user_wordbook_setting")
}

/// 系统配置表（需求 3.6）：键值对，运营方直接用 SQL 维护，服务端读取带 60 秒缓存
model SystemConfig {
  /// 配置键，如 site.name、ai.model、legal.privacy_policy
  key         String   @id
  /// 配置值（文本；数字、Markdown 正文均以文本存放）
  value       String
  /// 配置说明
  description String?
  /// 最近修改时间
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("system_config")
}

/// ECDICT 词典原始数据（MIT 协议，github.com/skywind3000/ECDICT），字段与 ecdict.csv 一致；供运营筛选写入 word 表及查词兜底，应用核心流程不依赖
model DictEntry {
  /// 词头（保留原大小写，唯一）
  word        String  @id
  /// 小写拼写（与 word.spelling 同规则，用于匹配）
  spelling    String
  /// 音标（IPA）
  phonetic    String?
  /// 英文释义（多行）
  definition  String?
  /// 中文释义（多行，每行「词性. 释义」）
  translation String?
  /// 词性及占比，如 n:52/v:48
  pos         String?
  /// 柯林斯星级 1–5；空为无
  collins     Int?
  /// 是否牛津 3000 核心词
  oxford      Boolean @default(false)
  /// 考试标签（空格分隔）：zk 中考 / gk 高考 / cet4 四级 / cet6 六级 / ky 考研 / toefl 托福 / ielts 雅思 / gre
  tag         String?
  /// BNC 语料词频排名（越小越常用；空为无）
  bnc         Int?
  /// 当代语料词频排名（越小越常用；空为无）
  frq         Int?
  /// 词形变化：p 过去式 / d 过去分词 / i 现在分词 / 3 三单 / r 比较级 / t 最高级 / s 复数 / 0 原形 / 1 变形类型
  exchange    String?
  /// 例句等扩展信息（JSON 文本，多为空）
  detail      String?
  /// 发音音频地址（多为空）
  audio       String?

  @@index([spelling])
  @@index([frq])
  @@map("dict_entry")
}

/// 允许合成发音音频的文本登记表：单词拼写或例句原文。按需合成接口只接受这里登记过的例句，也是批量生成脚本的待办清单
model AudioText {
  /// 规范化文本（去首尾空白、合并连续空格）的 SHA-1
  textHash  String      @id @map("text_hash")
  /// 类型：word 单词 / sentence 例句 / definition 中文（释义，以及跑步模式读的例句译文）
  kind      AudioKind
  /// 原文（单词拼写、例句或中文释义）
  text      String
  /// 登记时间
  createdAt DateTime    @default(now()) @map("created_at")
  clips     AudioClip[]

  @@map("audio_text")
}

/// 已合成的发音音频记录：每个文本 × 音色一行，文件在 AUDIO_DIR 下（路径可由类型、音色、文本推出，表只记状态与统计）
model AudioClip {
  /// 文本哈希，关联 audio_text
  textHash  String      @map("text_hash")
  /// 音色名（Edge 如 en-US-AriaNeural，Kokoro 如 af_heart）
  voice     String
  /// 合成引擎：edge / kokoro
  provider  String
  /// 相对 AUDIO_DIR 的文件路径
  path      String
  /// 文件大小（字节）
  bytes     Int         @default(0)
  /// 状态：ok 已生成 / failed 合成失败
  status    AudioStatus @default(ok)
  /// 失败原因
  error     String?
  /// 首次生成时间
  createdAt DateTime    @default(now()) @map("created_at")
  /// 最近更新时间
  updatedAt DateTime    @updatedAt @map("updated_at")
  text      AudioText   @relation(fields: [textHash], references: [textHash], onDelete: Cascade)

  @@id([textHash, voice])
  @@index([voice, status])
  @@map("audio_clip")
}
